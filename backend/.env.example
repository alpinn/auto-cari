# App
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# LLM Provider: "groq" (free), "claude" (prod)
LLM_PROVIDER=groq

# Groq (free tier, recommended for dev)
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# Claude (Anthropic)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5
CLAUDE_REASONING_MODEL=claude-sonnet-4

# Search
SERPER_API_KEY=...
TAVILY_API_KEY=...

# Cache (Upstash Redis REST)
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=...

# Database (Neon)
DATABASE_URL=postgresql://user:pass@host.neon.tech/autocari?sslmode=require

# Rate Limiting
MAX_QUERIES_PER_DAY=10
